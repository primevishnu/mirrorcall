# Copy to .env or run npm run setup. Replace every example value before hosting.
PUBLIC_DOMAIN=call.example.com
TURN_DOMAIN=turn.example.com
TURN_EXTERNAL_IP=203.0.113.10
SERVER_ACCESS_KEY=replace-with-a-random-key-at-least-24-characters
TURN_SHARED_SECRET=replace-with-a-different-random-secret
TURN_URLS=turn:turn.example.com:3478?transport=udp,turn:turn.example.com:3478?transport=tcp
STUN_URLS=stun:turn.example.com:3478
ALLOWED_ORIGINS=https://appassets.androidplatform.net,https://call.example.com
MAX_ROOMS=1
TRUST_PROXY=true
# Relay credentials must outlast the longest call (coturn re-checks them on refresh).
TURN_TTL_SECONDS=86400
